# Normalize line endings: repo stores LF, Windows checks out CRLF
* text=auto eol=lf

# Binary files — never modify line endings
*.png binary
*.jpg binary
*.gif binary
*.npy binary
*.pt  binary
*.pth binary
*.zip binary
*.xlsx binary

# Locally generated audited evidence must retain its exact hashed bytes.
benchmark/urbanflood/flood/region1_20m_drainage_v3_full/** -text
benchmark/urbanflood/geodata/region1_20m_drainage_v3_full/** -text
