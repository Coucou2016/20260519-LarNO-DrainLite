# Scientific arrays, trained estimators, and neural-network weights use Git LFS.
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.rpt binary
*.out binary

# Keep source and tabular metadata diffable.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Evidence manifests hash exact bytes; checkout must not rewrite line endings.
extended_study/output/** -text
LarNO-main/benchmark/urbanflood/flood/region1_20m_drainage_v3_full/** -text
LarNO-main/benchmark/urbanflood/geodata/region1_20m_drainage_v3_full/** -text
